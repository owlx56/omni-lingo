{
  "name": "onelingo",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "bun --bun node_modules/wxt/bin/wxt.mjs build",
    "build:firefox": "bun --bun node_modules/wxt/bin/wxt.mjs build -b firefox",
    "i18n:generate": "bun scripts/generate-i18n.ts",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "bun --bun node_modules/typescript/bin/tsc --noEmit",
    "postinstall": "bun --bun node_modules/wxt/bin/wxt.mjs prepare"
  },
  "dependencies": {
    "foliate-js": "github:johnfactotum/foliate-js#78914aef4466eb960965702401634c2cb348e9b1",
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "@wxt-dev/module-solid": "^1.1.4",
    "@onelingo/pdfjs-dist": "git@github.com:owlx56/pdfjs-dist.git#v5.7.284",
    "typescript": "^5.9.3",
    "wxt": "^0.20.23"
  }
}
