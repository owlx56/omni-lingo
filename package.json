{
  "name": "omni-lingo",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "bun --bun node_modules/wxt/bin/wxt.mjs build",
    "build:firefox": "bun --bun node_modules/wxt/bin/wxt.mjs build -b firefox",
    "i18n:generate": "bun scripts/generate-i18n.ts",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "bun --bun node_modules/typescript/bin/tsc --noEmit",
    "postinstall": "bun --bun node_modules/wxt/bin/wxt.mjs prepare"
  },
  "dependencies": {
    "foliate-js": "github:readest/foliate-js#1fc763b8e6afe10971043a6818dcb9e2d8c54f4a",
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "@wxt-dev/module-solid": "^1.1.4",
    "@omni-lingo/pdfjs-dist": "git@github.com:owlx56/pdfjs-dist.git#23389b8255d77b94674fd8c64e702acff2722fa6",
    "typescript": "^5.9.3",
    "wxt": "^0.20.23"
  }
}
