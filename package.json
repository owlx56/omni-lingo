{
  "name": "onelingo",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "bun --bun node_modules/wxt/bin/wxt.mjs build",
    "build:firefox": "bun --bun node_modules/wxt/bin/wxt.mjs build -b firefox",
    "i18n:generate": "bun scripts/generate-i18n.ts",
    "pdfjs:update": "bun scripts/update-pdfjs.ts",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "@wxt-dev/module-solid": "^1.1.4",
    "typescript": "^5.9.3",
    "wxt": "^0.20.23"
  }
}
